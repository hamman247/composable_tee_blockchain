FROM rust:1.79-slim as builder
WORKDIR /app
COPY . .
RUN apt-get update && apt-get install -y cmake gcc g++ pkg-config && \
    cargo build --release -p tee1-block-coordinator

FROM debian:bookworm-slim
COPY --from=builder /app/target/release/tee1-block-coordinator /usr/local/bin/
ENTRYPOINT ["tee1-block-coordinator"]
